# ──────────────────────────────────────────────────────────
# Antioquia Natural — Variables de entorno
# Copiar este archivo como .env y completar los valores reales
# NUNCA subir el archivo .env al repositorio
# ──────────────────────────────────────────────────────────

# Conexiones a MongoDB Atlas (mismo cluster, dos bases de datos separadas)
# BD Biodiversidad: catálogo de 150 especies (estático, curado)
MONGODB_URI_BIO=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/biodiversidad?retryWrites=true&w=majority
# BD Comunidad: registros de programas JPL y Guarda Cuencas (crecen con el tiempo)
MONGODB_URI_COM=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/comunidad?retryWrites=true&w=majority

# Puerto del servidor (por defecto 3000)
PORT=3000

# Secreto para las sesiones del panel de administración
# Usar una cadena aleatoria larga en producción (min. 32 caracteres)
SESSION_SECRET=cambiar_por_valor_aleatorio_seguro

# OBSOLETA — ya no la lee el código. El login pasó de una sola contraseña
# compartida a usuarios individuales (colección Usuario, panel en
# /admin/usuarios.html). Se deja documentada por si hace falta un rollback
# rápido a una versión anterior del código; crear el primer usuario con
# node src/scripts/seed_usuario_admin.js "Nombre" usuario clave12345678 Admin.Contenido
# ADMIN_PASSWORD_HASH=$2a$10$cambiar.por.el.hash.generado.con.el.comando.de.arriba

# Nivel de logs (error | warn | info | debug). Por defecto: info
LOG_LEVEL=info
# Carpeta donde se guardan los archivos de log. Por defecto: logs/ en la raíz del backend
# LOG_DIR=./logs

# Redis (caché de consultas frecuentes)
# En desarrollo: redis://localhost:6379 (requiere redis-server corriendo)
# En producción: URL del servidor Redis de la Gobernación
REDIS_URL=redis://localhost:6379

# reCAPTCHA v2 (checkbox) — protege el login del panel contra fuerza bruta/bots.
# Los valores de abajo son las claves de PRUEBA oficiales de Google (siempre
# válidas, pensadas para desarrollo/CI): https://developers.google.com/recaptcha/docs/faq
# IMPORTANTE: reemplazar por claves reales registradas para el dominio final
# (natural.antioquia.gov.co) antes de pasar a producción. El site key también
# está hardcodeado en admin/index.html (no es secreto, solo el secret key lo es).
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
